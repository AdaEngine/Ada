# Copy to fastlane/.env locally (ignored by Git).
# Public configuration:
IOS_PROVISIONING_PROFILE="Your App Store provisioning profile name"
MARKETING_VERSION=0.1.0
BUILD_NUMBER=1

# Supply these privately through your environment or a CI secret store.
# Never put actual credentials into this example.
ASC_KEY_ID=
ASC_ISSUER_ID=
# Choose exactly one: a .p8 file outside the checkout or its Base64 contents.
ASC_KEY_FILEPATH=
ASC_KEY_BASE64=
