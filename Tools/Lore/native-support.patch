diff --git a/Scripts/fetch-linux.py b/Scripts/fetch-linux.py
new file mode 100644
index 0000000..0fab86f
--- /dev/null
+++ b/Scripts/fetch-linux.py
@@ -0,0 +1,64 @@
+#!/usr/bin/env python3
+"""Fetch the official Linux Lore SDK and verify its release SHA-256."""
+import argparse
+import hashlib
+import os
+from pathlib import Path
+import platform
+import shutil
+import struct
+import tarfile
+import tempfile
+import urllib.request
+
+VERSION = "0.12.0"
+HASHES = {
+    "x86_64": "6f5ef04bd85428eaefe67e95ae7a00c4accdeb3fcda55c4b58a6663a692301ab",
+    "aarch64": "b0072a5dced01f518762c86fba1f5459393d1f713867353065d5cf92d2d2a108",
+}
+FILES = ("lore.h", "liblore.so", "LICENSE.txt", "THIRD-PARTY-NOTICES.txt")
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--architecture", default=platform.machine())
+    arguments = parser.parse_args()
+    aliases = {"amd64": "x86_64", "x86_64": "x86_64", "arm64": "aarch64", "aarch64": "aarch64"}
+    architecture = aliases.get(arguments.architecture.lower())
+    if architecture is None:
+        raise RuntimeError("Lore supports Linux x86_64 and ARM64, not " + arguments.architecture)
+    package = Path(__file__).resolve().parents[1]
+    destination = Path(os.environ.get("LORE_LINUX_SDK_PATH", package / "Vendor/linux"))
+    destination.mkdir(parents=True, exist_ok=True)
+    archive = destination / "liblore.tar.gz"
+    url = f"https://github.com/EpicGames/lore/releases/download/v{VERSION}/liblore-v{VERSION}-{architecture}-unknown-linux-gnu.tar.gz"
+    if not archive.exists() or hashlib.sha256(archive.read_bytes()).hexdigest() != HASHES[architecture]:
+        with tempfile.TemporaryDirectory(dir=destination) as temporary:
+            downloaded = Path(temporary) / archive.name
+            urllib.request.urlretrieve(url, downloaded)
+            if hashlib.sha256(downloaded.read_bytes()).hexdigest() != HASHES[architecture]:
+                raise RuntimeError("Lore SDK SHA-256 mismatch")
+            shutil.copyfile(downloaded, archive)
+    contents = {}
+    with tarfile.open(archive, "r:gz") as sdk:
+        for name in FILES:
+            try:
+                member = sdk.getmember(name)
+            except KeyError:
+                member = sdk.getmember("./" + name)
+            if not member.isfile():
+                raise RuntimeError("SDK entry must be a regular file: " + name)
+            with sdk.extractfile(member) as stream:
+                contents[name] = stream.read()
+    library = contents["liblore.so"]
+    machine = 62 if architecture == "x86_64" else 183
+    if len(library) < 20 or library[:6] != b"\x7fELF\x02\x01" or struct.unpack_from("<H", library, 18)[0] != machine:
+        raise RuntimeError("Lore shared library architecture mismatch")
+    for name, data in contents.items():
+        (destination / name).write_bytes(data)
+    (package / "Sources/CLore/include/lore.h").write_bytes(contents["lore.h"])
+    print(destination.resolve())
+
+
+if __name__ == "__main__":
+    main()
diff --git a/Scripts/fetch-windows.py b/Scripts/fetch-windows.py
new file mode 100644
index 0000000..e67ef84
--- /dev/null
+++ b/Scripts/fetch-windows.py
@@ -0,0 +1,40 @@
+#!/usr/bin/env python3
+"""Fetch the pinned official Windows x64 Lore SDK, checking its SHA-256."""
+import hashlib
+import os
+from pathlib import Path
+import shutil
+import tempfile
+import urllib.request
+import zipfile
+
+VERSION = "0.12.0"
+SHA256 = "0b9f00ec2d118969e6cb6acdc58dce5c246d3b8b16bdfc84797bf2f51c1e7a13"
+URL = f"https://github.com/EpicGames/lore/releases/download/v{VERSION}/liblore-v{VERSION}-x86_64-pc-windows-msvc.zip"
+DESTINATION = Path(os.environ.get("LORE_WINDOWS_SDK_PATH", Path(__file__).resolve().parents[1] / "Vendor/windows"))
+FILES = ("lore.h", "lore.dll.lib", "lore.dll", "LICENSE.txt", "THIRD-PARTY-NOTICES.txt")
+
+
+def main():
+    DESTINATION.mkdir(parents=True, exist_ok=True)
+    archive = DESTINATION / "liblore.zip"
+    if not archive.exists() or hashlib.sha256(archive.read_bytes()).hexdigest() != SHA256:
+        with tempfile.TemporaryDirectory(dir=DESTINATION) as temporary:
+            downloaded = Path(temporary) / "liblore.zip"
+            urllib.request.urlretrieve(URL, downloaded)
+            if hashlib.sha256(downloaded.read_bytes()).hexdigest() != SHA256:
+                raise RuntimeError("Lore SDK SHA-256 mismatch")
+            shutil.copyfile(downloaded, archive)
+    with zipfile.ZipFile(archive) as sdk:
+        for name in FILES:
+            # Extract only the known top-level files; never trust archive paths.
+            (DESTINATION / name).write_bytes(sdk.read(name))
+    # Swift consumers import CLore through its public include directory; they
+    # do not inherit the C target's SDK search flags.
+    public_header = Path(__file__).resolve().parents[1] / "Sources/CLore/include/lore.h"
+    public_header.write_bytes((DESTINATION / "lore.h").read_bytes())
+    print(DESTINATION.resolve())
+
+
+if __name__ == "__main__":
+    main()
