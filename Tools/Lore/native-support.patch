+name: Windows
+on: [push, pull_request, workflow_dispatch]
+jobs:
+  test:
+    runs-on: windows-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: compnerd/gha-setup-swift@main
+        with:
+          branch: swift-6.3-release
+          tag: 6.3.1-RELEASE
+      - name: Fetch verified native SDK
+        shell: pwsh
+        run: |
+          python Scripts/fetch-windows.py
+          "$pwd/Vendor/windows" | Out-File -Append -Encoding utf8 $env:GITHUB_PATH
+      - run: swift test --no-parallel --filter 'RepositoryTests|FileTests|RevisionTests|BranchTests|MetadataTests'
