{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common_types.json",
  "$defs": {
    "ComponentId": {
      "type": "string",
      "minLength": 1
    },
    "ChildList": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComponentId"
          }
        },
        {
          "type": "object",
          "properties": {
            "componentId": {
              "$ref": "#/$defs/ComponentId"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "componentId",
            "path"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
