    "theme": {
      "type": "object",
      "additionalProperties": false
    },
    "Check": {
      "type": "object",
      "properties": {
        "condition": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "call": {
                  "const": "required"
                },
                "args": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "oneOf": [
                        {
                          "$ref": "#/$defs/AbsoluteBinding"
                        },
                        {
                          "type": [
                            "string",
                            "number",
                            "boolean",
                            "array",
                            "null"
                          ]
                        }
                      ]
                    }
                  },
                  "required": [
                    "value"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "call",
                "args"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "call": {
                  "const": "range"
                },
                "args": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "oneOf": [
                        {
                          "$ref": "#/$defs/AbsoluteBinding"
                        },
                        {
                          "type": "number"
                        }
                      ]
                    },
                    "min": {
                      "type": "number"
                    },
                    "max": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "value",
                    "min",
                    "max"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "call",
                "args"
              ],
              "additionalProperties": false
            }
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "condition",
        "message"
      ],
      "additionalProperties": false
    }
  }
