{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaengine.org/a2ui/catalogs/forms/v1",
  "catalogId": "https://adaengine.org/a2ui/catalogs/forms/v1",
  "title": "AdaUI Forms Catalog v1",
  "description": "A2UI v0.9.1. Static children, absolute bindings, server events, single-string choices, numeric sliders, bounded required/range validation checks. Host styling; no general functions or collection templates.",
  "components": {
    "Text": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common_types.json#/$defs/ComponentId"
        },
        "component": {
          "const": "Text"
        },
        "text": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/AbsoluteBinding"
            }
          ]
        }
      },
      "required": [
        "id",
        "component",
        "text"
      ],
      "additionalProperties": false
    },
    "Column": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common_types.json#/$defs/ComponentId"
        },
        "component": {
          "const": "Column"
        },
        "children": {
          "allOf": [
            {
              "$ref": "common_types.json#/$defs/ChildList"
            },
            {
              "type": "array",
              "uniqueItems": true
            }
          ]
        },
        "spacing": {
          "type": "number",
          "minimum": 0,
          "maximum": 128
        }
      },
      "required": [
        "id",
        "component",
        "children"
      ],
      "additionalProperties": false
    },
    "Row": {
      "type": "object",
