            "id": {
              "$ref": "common_types.json#/$defs/ComponentId"
            },
            "component": {
              "const": "ChoicePicker"
            },
            "label": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/AbsoluteBinding"
                }
              ]
            },
            "value": {
              "$ref": "#/$defs/AbsoluteBinding"
            },
            "options": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
