          ]
        },
        "value": {
          "$ref": "#/$defs/AbsoluteBinding"
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "label",
              "value"
            ],
            "additionalProperties": false
          }
        },
        "checks": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/Check"
          }
        }
      },
      "required": [
        "id",
        "component",
        "value",
        "options"
      ],
      "additionalProperties": false
