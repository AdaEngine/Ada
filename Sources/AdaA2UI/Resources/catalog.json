  "functions": {
    "required": {
      "type": "object",
      "properties": {
        "call": {
          "const": "required"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "oneOf": [
                {
                  "$ref": "#/$defs/AbsoluteBinding"
                },
                {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "array",
                    "null"
                  ]
                }
              ]
            }
          },
          "required": [
            "value"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "call",
        "args"
      ],
      "additionalProperties": false
    },
    "range": {
      "type": "object",
      "properties": {
        "call": {
          "const": "range"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "oneOf": [
                {
                  "$ref": "#/$defs/AbsoluteBinding"
                },
                {
                  "type": "number"
                }
              ]
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          },
          "required": [
            "value",
            "min",
            "max"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "call",
        "args"
      ],
      "additionalProperties": false
    }
  },
  "theme": {
    "type": "object",
    "additionalProperties": false
  },
  "$defs": {
    "AbsoluteBinding": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "ServerAction": {
      "type": "object",
      "properties": {
        "event": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "context": {
              "type": "object",
              "additionalProperties": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/AbsoluteBinding"
                  },
                  {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null",
                      "array"
                    ]
                  },
                  {
                    "type": "object",
                    "not": {
                      "required": [
                        "path"
                      ]
                    }
                  }
                ]
              }
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "event"
      ],
      "additionalProperties": false
    },
    "anyComponent": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "common_types.json#/$defs/ComponentId"
            },
            "component": {
