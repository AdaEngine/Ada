        "action": {
          "$ref": "#/$defs/ServerAction"
        },
        "checks": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/Check"
          }
        }
      },
      "required": [
        "id",
        "component",
        "text",
        "action"
      ],
      "additionalProperties": false
    },
    "ChoicePicker": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common_types.json#/$defs/ComponentId"
        },
        "component": {
          "const": "ChoicePicker"
        },
        "label": {
          "oneOf": [
            {
              "type": "string"
