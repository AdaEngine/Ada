        },
        "spacing": {
          "type": "number",
          "minimum": 0,
          "maximum": 128
        }
      },
      "required": [
        "id",
        "component",
        "children"
      ],
      "additionalProperties": false
    },
    "TextField": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common_types.json#/$defs/ComponentId"
        },
        "component": {
          "const": "TextField"
        },
        "text": {
          "$ref": "#/$defs/AbsoluteBinding"
        },
        "placeholder": {
          "type": "string"
        },
        "checks": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/Check"
          }
        }
      },
      "required": [
        "id",
        "component",
        "text"
      ],
      "additionalProperties": false
    },
    "Toggle": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common_types.json#/$defs/ComponentId"
        },
        "component": {
          "const": "Toggle"
