              "$ref": "#/$defs/AbsoluteBinding"
            }
          ]
        },
        "value": {
          "$ref": "#/$defs/AbsoluteBinding"
        },
        "checks": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/Check"
          }
        }
      },
      "required": [
        "id",
        "component",
